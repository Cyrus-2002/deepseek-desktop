{
  "name": "dsh-desktop-bridge",
  "version": "0.5.0",
  "private": true,
  "description": "DeepSeek Desktop 桌面壳的原生界面桥：把桌面功能（API 用量 / 检查更新 / 数据目录）以官方槽位渲染进 dsh Web UI 的系统设置与侧边栏。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
