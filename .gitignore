# 依赖与构建产物
node_modules/
dist/

# 运行时/用户数据（机器相关，不应提交）
logs/
userdata/
session/
usage/
storages/
profiles/
settings.yaml
.credentials.yaml
.anonymous-user-id
.env

# 本机配置（含 harnessRoot 绝对路径，属机器相关；首次运行自动生成默认值）
config.json

# 打包脚本的 Electron 下载缓存（可用 ELECTRON_CACHE 环境变量改到别处）
.electron-cache/

# 运行时生成的用户数据：Agent 预设 / Skills 目录下仅提交随项目发布的示例
.agent-presets/*
!.agent-presets/README.md
!.agent-presets/_shared/
!.agent-presets/example/
!.agent-presets/sd-architect/
!.agent-presets/sd-dev/
!.agent-presets/sd-orchestrator/
!.agent-presets/sd-pm/
!.agent-presets/sd-qa/
!.agent-presets/sd-reviewer/
!.agent-presets/sd-ui/
!.agent-presets/sd-ux/
skills/*/
!skills/example-skill/

# 工具目录
.claude/
# AI 编码代理的工作区目录
.zcode/

# 桌面桥插件的本地构建依赖（lib/ 手写产物随仓库提交）
dsh-plugin/node_modules/
